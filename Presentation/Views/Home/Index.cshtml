@{
    ViewData["Title"] = "Student Housing - Home";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-primary fw-bold mb-4">Welcome to Student Housing</h1>
    <p class="lead mb-5">Find your perfect student accommodation securely and easily.</p>

    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5">
            <i class="fas fa-sign-in-alt"></i> Login
        </a>
        <a asp-controller="Account" asp-action="RegisterChoice" class="btn btn-outline-primary btn-lg px-5">
            <i class="fas fa-user-plus"></i> Create Account
        </a>
    </div>
</div>

@model Domain.Entities.LandLord

@{
    ViewData["Title"] = "Delete Landlord";
}

<div class="container mt-4">
    <h1>Delete Landlord</h1>
    
    <h3>Are you sure you want to delete this landlord?</h3>
    
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Landlord ID</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.LandLordId)</dd>

                <dt class="col-sm-3">Company Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CompanyName)</dd>

                <dt class="col-sm-3">National ID</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NationalId)</dd>

                <dt class="col-sm-3">Verification Status</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.VerificationStatus)</dd>
            </dl>
        </div>
    </div>
    
    <form asp-action="DeleteLandlord" method="post" class="mt-3">
        <input type="hidden" asp-for="LandLordId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Landlords" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Admin Dashboard</h1>
            <p class="text-muted mb-0">Manage Students and Landlords</p>
        </div>
        <a asp-action="Profile" class="btn btn-primary px-4">
            <i class="fas fa-user-circle me-2"></i>My Profile
        </a>
    </div>

    <div class="row mt-2">
        <div class="col-md-6">
            <div class="card text-white bg-primary mb-3 shadow">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-graduation-cap me-2"></i>Students</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">View, approve, reject and manage student accounts.</p>
                    <a asp-action="Students" class="btn btn-light fw-bold">Manage Students</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-white bg-success mb-3 shadow">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-building me-2"></i>Landlords</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">View, approve, reject and manage landlord accounts.</p>
                    <a asp-action="Landlords" class="btn btn-light fw-bold">Manage Landlords</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-danger">
                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                </button>
            </form>
        </div>
    </div>
</div>

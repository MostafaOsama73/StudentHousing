@model Presentation.Models.AdminStudentViewModel

@{
    ViewData["Title"] = "Manage Students";
}

<div class="container mt-4">
    <h1>Manage Students</h1>
    
    <div class="mb-3">
        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    <form asp-action="Students" method="get" class="mb-3">
        <div class="row">
            <div class="col-md-4">
                <input type="text" name="search" class="form-control" placeholder="Search students..." value="@Model.Search" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Students" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </form>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Email</th>
                <th>Address</th>
                <th>City</th>
                <th>Preferred Area</th>
                <th>National ID</th>
                <th>Date of Birth</th>
                <th>Gender</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Students)
            {
                <tr>
                    <td>@(item.User?.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Address)</td>
                    <td>@Html.DisplayFor(modelItem => item.City)</td>
                    <td>@Html.DisplayFor(modelItem => item.PreferredArea)</td>
                    <td>@Html.DisplayFor(modelItem => item.NationalId)</td>
                    <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                    <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                    <td>
                        @if (item.User?.Status == Shared.Enums.UserStatus.Pending)
                        {
                            <span class="badge bg-warning">Pending</span>
                        }
                        else if (item.User?.Status == Shared.Enums.UserStatus.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (item.User?.Status == Shared.Enums.UserStatus.Rejected)
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                    </td>
                    <td>
                        <a asp-action="StudentDetails" asp-route-id="@item.StudentId" class="btn btn-sm btn-info">Details</a>
                        @if (item.User?.Status == Shared.Enums.UserStatus.Pending)
                        {
                            <a asp-action="ApproveStudent" asp-route-id="@item.StudentId" class="btn btn-sm btn-success">Approve</a>
                            <a asp-action="RejectStudent" asp-route-id="@item.StudentId" class="btn btn-sm btn-danger">Reject</a>
                        }
                        <a asp-action="ActivateStudent" asp-route-id="@item.StudentId" class="btn btn-sm btn-success">Activate</a>
                        <a asp-action="DeactivateStudent" asp-route-id="@item.StudentId" class="btn btn-sm btn-warning">Deactivate</a>
                        <a asp-action="DeleteStudent" asp-route-id="@item.StudentId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Students" asp-route-pageNumber="@(Model.CurrentPage - 1)" 
                       asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Students" asp-route-pageNumber="@i" 
                       asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search">@i</a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Students" asp-route-pageNumber="@(Model.CurrentPage + 1)" 
                       asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search">Next</a>
                </li>
            }
        </ul>
    </nav>

    <div class="mt-3">
        Showing @Model.Students.Count() of @Model.TotalCount students
    </div>
</div>

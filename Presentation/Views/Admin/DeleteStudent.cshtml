@model Domain.Entities.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-4">
    <h1>Delete Student</h1>
    
    <h3>Are you sure you want to delete this student?</h3>
    
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Student ID</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.StudentId)</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>

                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.City)</dd>

                <dt class="col-sm-3">National ID</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NationalId)</dd>
            </dl>
        </div>
    </div>
    
    <form asp-action="DeleteStudent" method="post" class="mt-3">
        <input type="hidden" asp-for="StudentId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Students" class="btn btn-secondary">Cancel</a>
    </form>
</div>

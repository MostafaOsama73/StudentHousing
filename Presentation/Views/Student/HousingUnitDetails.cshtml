@model Domain.Entities.HousingUnit

@{
    ViewData["Title"] = "Housing Unit Details";
}

<div class="container mt-4">
    <h1>Housing Unit Details</h1>
    
    <div class="mb-3">
        <a asp-action="HousingUnits" class="btn btn-secondary">Back to Housing Units</a>
    </div>

    <div class="card">
        <div class="card-body">
            <h2 class="card-title">@Html.DisplayFor(model => model.Title)</h2>
            <h4 class="card-subtitle mb-2 text-muted">@Html.DisplayFor(model => model.City) - @Html.DisplayFor(model => model.Area)</h4>
            
            <hr />
            
            <dl class="row">
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">$@Html.DisplayFor(model => model.Price) / month</dd>

                <dt class="col-sm-3">Area</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Area)</dd>

                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.City)</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>

                <dt class="col-sm-3">Number of Rooms</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NumberOfRooms)</dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Location)</dd>

                <dt class="col-sm-3">Gender Allowed</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.GenderAllowed)</dd>

                <dt class="col-sm-3">Average Rating</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.AverageRating)</dd>

                <dt class="col-sm-3">Landlord</dt>
                <dd class="col-sm-9">@(Model.LandLord?.CompanyName)</dd>
            </dl>
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-action="BookHousingUnit" asp-route-id="@Model.HousingUnitId" class="btn btn-primary btn-lg">Book This Unit</a>
    </div>
</div>

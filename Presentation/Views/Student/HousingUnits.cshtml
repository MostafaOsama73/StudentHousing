@model Presentation.Models.StudentHousingUnitViewModel

@{
    ViewData["Title"] = "Housing Units";
}

<div class="container mt-4">
    <h1>Available Housing Units</h1>

    <div class="mb-3">
        <a asp-action="Index" class="btn btn-secondary">Back to Profile</a>
    </div>

    <form asp-action="HousingUnits" method="get" class="mb-3">
        <div class="row">
            <div class="col-md-3">
                <input type="text" name="search" class="form-control" placeholder="Search..." value="@Model.Search" />
            </div>
            <div class="col-md-2">
                <input type="text" name="city" class="form-control" placeholder="City" value="@Model.City" />
            </div>
            <div class="col-md-2">
                <input type="number" name="minPrice" class="form-control" placeholder="Min Price" value="@Model.MinPrice" />
            </div>
            <div class="col-md-2">
                <input type="number" name="maxPrice" class="form-control" placeholder="Max Price" value="@Model.MaxPrice" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
            <div class="col-md-1">
                <a asp-action="HousingUnits" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </form>

    <div class="row">
        @foreach (var item in Model.HousingUnits)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.Title)</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@Html.DisplayFor(modelItem => item.City) - @Html.DisplayFor(modelItem => item.Area)</h6>
                        <p class="card-text">@Html.DisplayFor(modelItem => item.Description)</p>
                        <p class="card-text"><strong>Price: $@Html.DisplayFor(modelItem => item.Price) / month</strong></p>
                        <p class="card-text"><small class="text-muted">Landlord: @Html.DisplayFor(modelItem => item.LandLord.CompanyName)</small></p>
                        <a asp-action="HousingUnitDetails" asp-route-id="@item.HousingUnitId" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="BookHousingUnit" asp-route-id="@item.HousingUnitId" class="btn btn-primary btn-sm">Book Now</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="HousingUnits" asp-route-pageNumber="@(Model.CurrentPage - 1)" 
                       asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" 
                       asp-route-city="@Model.City" asp-route-minPrice="@Model.MinPrice" 
                       asp-route-maxPrice="@Model.MaxPrice">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="HousingUnits" asp-route-pageNumber="@i" 
                       asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" 
                       asp-route-city="@Model.City" asp-route-minPrice="@Model.MinPrice" 
                       asp-route-maxPrice="@Model.MaxPrice">@i</a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="HousingUnits" asp-route-pageNumber="@(Model.CurrentPage + 1)" 
                       asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" 
                       asp-route-city="@Model.City" asp-route-minPrice="@Model.MinPrice" 
                       asp-route-maxPrice="@Model.MaxPrice">Next</a>
                </li>
            }
        </ul>
    </nav>

    <div class="mt-3">
        Showing @Model.HousingUnits.Count() of @Model.TotalCount housing units
    </div>
</div>

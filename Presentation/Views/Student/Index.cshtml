@model Presentation.Models.StudentIndexViewModel

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Search..." value="@Model.Search" />
        </div>
        <div class="col-md-2">
            <select name="sortBy" class="form-control">
                <option value="">Sort By</option>
                <option value="address" selected="@(Model.SortBy == "address")">Address</option>
                <option value="city" selected="@(Model.SortBy == "city")">City</option>
                <option value="preferredarea" selected="@(Model.SortBy == "preferredarea")">Preferred Area</option>
                <option value="nationalid" selected="@(Model.SortBy == "nationalid")">National ID</option>
                <option value="dateofbirth" selected="@(Model.SortBy == "dateofbirth")">Date of Birth</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="ascending" class="form-control">
                <option value="true" selected="@(Model.Ascending)">Ascending</option>
                <option value="false" selected="@(!Model.Ascending)">Descending</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary">Filter</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortBy="address" asp-route-ascending="@(Model.SortBy == "address" ? !Model.Ascending : true)" asp-route-search="@Model.Search">Address</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="city" asp-route-ascending="@(Model.SortBy == "city" ? !Model.Ascending : true)" asp-route-search="@Model.Search">City</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="preferredarea" asp-route-ascending="@(Model.SortBy == "preferredarea" ? !Model.Ascending : true)" asp-route-search="@Model.Search">Preferred Area</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="nationalid" asp-route-ascending="@(Model.SortBy == "nationalid" ? !Model.Ascending : true)" asp-route-search="@Model.Search">National ID</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortBy="dateofbirth" asp-route-ascending="@(Model.SortBy == "dateofbirth" ? !Model.Ascending : true)" asp-route-search="@Model.Search">Date of Birth</a>
            </th>
            <th>Gender</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Students)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                <td>@Html.DisplayFor(modelItem => item.City)</td>
                <td>@Html.DisplayFor(modelItem => item.PreferredArea)</td>
                <td>@Html.DisplayFor(modelItem => item.NationalId)</td>
                <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)" 
                   asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" 
                   asp-route-sortBy="@Model.SortBy" asp-route-ascending="@Model.Ascending">Previous</a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" 
                   asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" 
                   asp-route-sortBy="@Model.SortBy" asp-route-ascending="@Model.Ascending">@i</a>
            </li>
        }

        @if (Model.HasNextPage) 
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)" 
                   asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" 
                   asp-route-sortBy="@Model.SortBy" asp-route-ascending="@Model.Ascending">Next</a>
            </li>
        }
    </ul>
</nav>

<div class="mt-3">
    Showing @Model.Students.Count() of @Model.TotalCount students
</div>

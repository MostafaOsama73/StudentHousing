@{
    ViewData["Title"] = "Pending Verification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5 text-center">
                    <!-- Pending Icon -->
                    <div class="mb-4">
                        <div style="display: inline-block; width: 100px; height: 100px; background: rgba(255, 193, 7, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-hourglass-half fa-4x text-warning"></i>
                        </div>
                    </div>

                    <h2 class="card-title mb-3">Account Pending Verification</h2>
                    
                    <p class="card-text text-muted mb-4">
                        Thank you for registering as a landlord! Your account has been created successfully.
                    </p>

                    <div class="alert alert-warning alert-dismissible fade" role="alert">
                        <i class="fas fa-info-circle"></i>
                        <strong>Your account is currently being reviewed by our admin team.</strong>
                        <p class="mt-2 mb-0">
                            We typically verify accounts within 24-48 hours. You'll receive an email notification once your account is activated.
                        </p>
                    </div>

                    <div class="row mt-5 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3">
                                <i class="fas fa-file-upload fa-2x text-primary mb-2"></i>
                                <h6>Documents Submitted</h6>
                                <p class="small text-muted">Your ownership proof is being verified</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3">
                                <i class="fas fa-clipboard-check fa-2x text-warning mb-2"></i>
                                <h6>Under Review</h6>
                                <p class="small text-muted">Admin team is reviewing your information</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3">
                                <i class="fas fa-bell fa-2x text-success mb-2"></i>
                                <h6>You'll Be Notified</h6>
                                <p class="small text-muted">Check your email for updates</p>
                            </div>
                        </div>
                    </div>

                    <!-- What You Can Do Section -->
                    <div class="bg-light p-4 rounded-3 mb-4 text-start">
                        <h5 class="mb-3">
                            <i class="fas fa-tasks text-primary"></i> What You Can Do Now
                        </h5>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="ms-2">Watch for verification email</span>
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="ms-2">Prepare your property information</span>
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="ms-2">Have clear property photos ready</span>
                            </li>
                            <li>
                                <i class="fas fa-check-circle text-success"></i>
                                <span class="ms-2">Check spam folder for emails</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2">
                        <a href="/" class="btn btn-primary btn-lg">
                            <i class="fas fa-home"></i> Return to Home
                        </a>
                        <a href="mailto:support@studenthousing.com" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-envelope"></i> Contact Support
                        </a>
                    </div>

                    <!-- Footer Info -->
                    <div class="mt-4 pt-3 border-top">
                        <p class="small text-muted mb-0">
                            <i class="fas fa-shield-alt"></i> Your account credentials are secure
                        </p>
                        <p class="small text-muted">
                            Typical verification time: <strong>24-48 hours</strong>
                        </p>
                    </div>
                </div>
            </div>

            <!-- FAQ Section -->
            <div class="mt-5">
                <h5 class="mb-4">Frequently Asked Questions</h5>
                
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item border-0 mb-3 rounded-3 shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                How long does verification take?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Verification typically takes 24-48 hours. However, during peak times it may take up to 72 hours.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 mb-3 rounded-3 shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                What documents do I need?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                You need to provide proof of property ownership such as a deed, title, or lease agreement.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 rounded-3 shadow-sm">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                Can I login while pending?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                No, your account is inactive during verification. Once approved, you can login and start listing properties.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 20px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
        color: #0d6efd;
    }

    .accordion-item {
        border: none !important;
    }

    .btn:hover {
        transform: translateY(-2px);
    }
</style>

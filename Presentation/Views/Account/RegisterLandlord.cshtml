@{
    ViewData["Title"] = "Landlord Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <h2 class="text-center mb-2 text-success">
                        <i class="fas fa-building"></i> Landlord Registration
                    </h2>
                    <p class="text-center text-muted mb-4">List your properties and start earning</p>

                    <!-- Info Alert -->
                    <div class="alert alert-info alert-dismissible fade" role="alert">
                        <i class="fas fa-info-circle"></i> Your account will require admin verification before activation.
                    </div>

                    <form id="landlordRegisterForm" asp-action="RegisterLandlord" asp-controller="Account" method="post">
                        <input type="hidden" name="ProfileImage" id="ProfileImageHidden" />
                        <div class="row">
                            <!-- Email -->
                            <div class="col-md-12 mb-3">
                                <label for="email" class="form-label fw-bold">Email Address *</label>
                                <input type="email" class="form-control form-control-lg" id="email" 
                                       name="email" placeholder="your@email.com" required>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-12 mb-3">
                                <label for="phoneNumber" class="form-label fw-bold">Phone Number *</label>
                                <input type="tel" class="form-control form-control-lg" id="phoneNumber" 
                                       name="phoneNumber" placeholder="+20 1XXX XXXXXX" required>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6 mb-3">
                                <label for="password" class="form-label fw-bold">Password *</label>
                                <input type="password" class="form-control form-control-lg" id="password" 
                                       name="password" placeholder="Min 6 characters" required>
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-info-circle"></i> Must contain uppercase, lowercase, and number
                                </small>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-md-6 mb-3">
                                <label for="confirmPassword" class="form-label fw-bold">Confirm Password *</label>
                                <input type="password" class="form-control form-control-lg" id="confirmPassword" 
                                       name="confirmPassword" placeholder="Confirm password" required>
                            </div>

                            <!-- Company Name -->
                            <div class="col-md-12 mb-3">
                                <label for="companyName" class="form-label fw-bold">Company Name</label>
                                <input type="text" class="form-control form-control-lg" id="companyName" 
                                       name="companyName" placeholder="Your company name (optional)">
                            </div>

                            <!-- National ID -->
                            <div class="col-md-6 mb-3">
                                <label for="nationalId" class="form-label fw-bold">National ID *</label>
                                <input type="text" class="form-control form-control-lg" id="nationalId" 
                                       name="nationalId" placeholder="Your national ID number" required>
                            </div>

                            <!-- Property Ownership Proof -->
                            <div class="col-md-6 mb-3">
                                <label for="propertyOwnershipProof" class="form-label fw-bold">Ownership Document *</label>
                                <input type="text" class="form-control form-control-lg" id="propertyOwnershipProof" 
                                       name="propertyOwnershipProof" placeholder="Document URL or path" required>
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-info-circle"></i> Upload your property ownership documents
                                </small>
                            </div>

                            <!-- Profile Image -->
                            <div class="col-md-12 mb-3">
                                <label for="profileImage" class="form-label fw-bold">Profile Picture (Optional)</label>
                                <div class="input-group">
                                    <input type="file" class="form-control form-control-lg" id="profileImage" 
                                           name="profileImage" accept="image/*">
                                    <span class="input-group-text">Upload</span>
                                </div>
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-info-circle"></i> Max 5MB, JPG/PNG recommended
                                </small>
                        <input type="hidden" name="ProfileImage" id="ProfileImageHidden" />
                        <div class="row">
                            <!-- Email -->
                            <div class="col-md-12 mb-3">
                                <label for="email" class="form-label fw-bold">Email Address *</label>
                                <input type="email" class="form-control form-control-lg" id="email" 
                                       name="email" placeholder="your@email.com" required>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-12 mb-3">
                                <label for="phoneNumber" class="form-label fw-bold">Phone Number *</label>
                                <input type="tel" class="form-control form-control-lg" id="phoneNumber" 
                                       name="phoneNumber" placeholder="+20 1XXX XXXXXX" required>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6 mb-3">
                                <label for="password" class="form-label fw-bold">Password *</label>
                                <input type="password" class="form-control form-control-lg" id="password" 
                                       name="password" placeholder="Min 6 characters" required>
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-info-circle"></i> Must contain uppercase, lowercase, and number
                                </small>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-md-6 mb-3">
                                <label for="confirmPassword" class="form-label fw-bold">Confirm Password *</label>
                                <input type="password" class="form-control form-control-lg" id="confirmPassword" 
                                       name="confirmPassword" placeholder="Confirm password" required>
                            </div>

                            <!-- Company Name -->
                            <div class="col-md-12 mb-3">
                                <label for="companyName" class="form-label fw-bold">Company Name</label>
                                <input type="text" class="form-control form-control-lg" id="companyName" 
                                       name="companyName" placeholder="Your company name (optional)">
                            </div>

                            <!-- National ID -->
                            <div class="col-md-6 mb-3">
                                <label for="nationalId" class="form-label fw-bold">National ID *</label>
                                <input type="text" class="form-control form-control-lg" id="nationalId" 
                                       name="nationalId" placeholder="Your national ID number" required>
                            </div>

                            <!-- Property Ownership Proof -->
                            <div class="col-md-6 mb-3">
                                <label for="propertyOwnershipProof" class="form-label fw-bold">Ownership Document *</label>
                                <input type="text" class="form-control form-control-lg" id="propertyOwnershipProof" 
                                       name="propertyOwnershipProof" placeholder="Document URL or path" required>
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-info-circle"></i> Upload your property ownership documents
                                </small>
                            </div>

                            <!-- Profile Image -->
                            <div class="col-md-12 mb-3">
                                <label for="profileImage" class="form-label fw-bold">Profile Picture (Optional)</label>
                                <div class="input-group">
                                    <input type="file" class="form-control form-control-lg" id="profileImage" 
                                           name="profileImage" accept="image/*">
                                    <span class="input-group-text">Upload</span>
                                </div>
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-info-circle"></i> Max 5MB, JPG/PNG recommended
                                </small>
                                <!-- Image Preview -->
                                <div id="imagePreview" class="mt-3 d-none">
                                    <img id="previewImg" src="" alt="Preview" class="img-thumbnail" style="max-width: 200px; max-height: 200px;">
                                </div>
                            </div>

                            <!-- Alerts -->
                            <div class="col-md-12">
                                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
                            </div>

                            <!-- Submit Button -->
                            <div class="col-md-12 mt-4">
                                <button type="button" class="btn btn-success btn-lg w-100" 
                                        id="registerBtn" onclick="registerLandlord()">
                                    <i class="fas fa-user-plus"></i> Create Landlord Account
                                </button>
                            </div>

                            <!-- Login Link -->
                            <div class="col-md-12 text-center mt-3">
                                <p class="text-muted">
                                    Already have an account?
                                    <a href="@Url.Action("Login")" class="text-primary fw-bold">Login here</a>
                                </p>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Features Section -->
            <div class="row mt-5">
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-light p-4 rounded-3">
                            <i class="fas fa-list-check fa-2x text-success mb-3"></i>
                            <h5>Easy Listing</h5>
                            <p class="text-muted">List properties in minutes</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-light p-4 rounded-3">
                            <i class="fas fa-chart-line fa-2x text-success mb-3"></i>
                            <h5>Track Performance</h5>
                            <p class="text-muted">Monitor bookings and earnings</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-light p-4 rounded-3">
                            <i class="fas fa-users fa-2x text-success mb-3"></i>
                            <h5>Manage Tenants</h5>
                            <p class="text-muted">Connect with quality students</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 20px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(25, 135, 84, 0.4);
    }

    .form-label {
        color: #333;
        font-size: 0.95rem;
    }

    .bg-light {
        background-color: #f8f9fa !important;
    }
</style>

<script>
function registerLandlord() {
    const form = document.getElementById('landlordRegisterForm');
    const profileImageInput = document.getElementById('profileImage');

    // Trigger HTML5 validation
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    // Additional validation (e.g. password match)
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    if (password !== confirmPassword) {
        alert("Passwords do not match");
        return;
    }

    // Handle image upload if file is selected
    if (profileImageInput.files.length > 0) {
        const file = profileImageInput.files[0];
        
        // Validate file size (5MB max)
        if (file.size > 5 * 1024 * 1024) {
            alert('Image file must be less than 5MB');
            return;
        }

        // Validate file type
        if (!file.type.startsWith('image/')) {
            alert('Please select a valid image file');
            return;
        }

        // Convert file to Base64
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('ProfileImageHidden').value = e.target.result;
            form.submit();
        };
        reader.onerror = function() {
            alert('Error reading image file');
        };
        reader.readAsDataURL(file);
    } else {
        form.submit();
    }
}

// Image preview on file selection
document.addEventListener('DOMContentLoaded', function() {
    const profileImageInput = document.getElementById('profileImage');
    const imagePreview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    
    profileImageInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                imagePreview.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        } else {
            imagePreview.classList.add('d-none');
        }
    });
});
</script>
